rules_version = '2';

// Suggested Storage rules for bouquet photo uploads. Like firestore.rules, this isn't
// deployed automatically — copy it into Firebase Console > Storage > Rules.
service firebase.storage {
  match /b/{bucket}/o {
    match /bouquets/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
